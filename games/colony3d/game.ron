#![enable(implicit_some)]
// Colony 3D. The colony rebuilt for simcraft's 3D worlds and renderer (the 2D original: games/colony).
// The nest is a physical place: a shaft into the soil, a granary at level 3, a deep chamber at level 5.
//   Temperature is a field. The air pins the surface; heat diffuses slowly through the soil, so deep soil lags
//   the seasons (cool in summer, mild in winter). Ants add body heat. Each ant feels the temperature where it is.
//   Scent is a field that evaporates. Foragers lay it on the way home; searchers climb it.
//   In winter ants go down and climb the warmth gradient: where they cluster is found, not scripted.
// Research: docs/research/ant-colony.md. Ends when the last ant dies.
Game(
    name: "colony3d",
    environments: ["seasons"],

    fields: {
        "soil":  (init: 0),
        // Centidegrees (0..10000): integer diffusion needs fine units, or small flows round to nothing.
        "temp":  (init: 5000, diffusion: 20, top: "env.seasons.warmth * 100"),
        "scent": (init: 0, decay: 4),
    },
    terrain: "soil",

    kinds: {
        "entrance": (glyph: 'O'),
        "nest":   (glyph: 'N', fsm: "nest", props: { "food": 0, "born": 0, "income": 0, "spoiled": 0, "rally": 0 },
                   senses: { "first_tick": "tick == 0", "clock": "tick" }),
        "bush":   (glyph: '*', solid: true, fsm: "bush", props: { "berries": 0, "quality": -1, "value": 1 },
                   glyphs: { "Ripe": '*', "Bare": 'o' },
                   senses: { "clock": "tick", "summer": r#"env.seasons.state == "Summer""#,
                             "ripeness": "env.seasons.ripeness" }),
        "ant":    (glyph: 'a', fsm: "ant",
                   props: { "age": 0, "threshold": -1, "tolerance": -1, "store": 0, "hunger": 0, "appetite": 0,
                            "load": 0, "trail": 0, "searched": 0 },
                   glyphs: { "Nurse": 'n', "Ready": 'r', "Search": 'a', "Carry": 'c', "Dormant": 'z' },
                   // What an ant knows: the temperature of the voxel it stands in, and its clock.
                   senses: { "clock": "tick", "summer": r#"env.seasons.state == "Summer""#,
                             "winter": r#"env.seasons.state == "Winter""#,
                             "warmth": r#"field("temp") / 100"#,
                             "moving": r#"p.cold_moves == 0 || rand(100) < max(p.min_speed, field("temp") / 100)"# }),
    },
    params: {
        "body_heat": 20,          // centidegrees an ant adds to its voxel per tick underground (agents shape their climate)
        "noise": 20,              // % of steps a searcher wanders instead of climbing the scent
        "scent_max": 200,
        // Food.
        "start_food": 40,
        // The player (the colony's will; `play.toml` makes the nest controllable).
        "lay_cost": 8,            // food for an egg laid on command
        "rally_ticks": 40,        // a rally sends waiting foragers out for this long
        "warm_cost": 4, "warm_heat": 1500,  // food burnt to warm the nest chamber (centidegrees)
        // Spoilage: stored food above spoil_above goes off, one unit every spoil_every ticks in warm weather (0 = never);
        // spoiled food rots away, one unit every rot_every ticks.
        "spoil_every": 0, "spoil_above": 30, "rot_every": 25,
        "bush_max": 6,            // berries on a full bush
        "berry_value": 6,         // average food a berry is worth (one trip must feed more than the forager eats)
        "quality_min": 50, "quality_spread": 101,  // each bush's quality, % of average
        "regrow_every": 12,       // one berry per bush this often, summer only
        "meal_every": 16,         // an active ant eats one food this often (in full warmth, if cold_metabolism)
        "cold_metabolism": 1,     // 1 = active ants burn food in proportion to the warmth they feel (Q10: ectotherms)
        "cold_floor": 10,         // ...but never below this % of the summer rate
        "dormant_below": 0,       // > 0 = go dormant whenever warmth is below this, not only in winter
        "winter_meal_every": 48,  // a dormant ant eats this rarely
        "starve_at": 40, "starve_spread": 60,  // an ant dies after starve_at + rand(starve_spread) hungry ticks
        // Brood.
        "egg_cost": 4, "lay_chance": 6,     // % per nurse per tick, summer only
        "brood_reserve": 20,      // nurses keep this much food back: brood follows income, not hope
        "cold_moves": 1, "min_speed": 10,  // 1 = ants move on warmth % of ticks (never below min_speed %)
        "brood_warmth": 1,        // 1 = brood is raised faster in a warm nest (lay chance × felt warmth %)
        "hungry_store": 20,       // below this much food the colony counts as hungry
        // Division of labour.
        "forage_age": 60, "forage_spread": 60, // an ant forages from forage_age + rand(forage_spread)
        "hunger_push": 40,        // a hungry colony sends ants out this much younger
        // Leaving the nest (interaction rate).
        "entrance_r": 2, "contacts": 2, "scout_chance": 6,
        // Searching and stigmergy.
        "patience": 80,           // a searcher gives up and goes back after this long
        "trail_per_value": 10, "trail_step": 3, // scent laid at the food per unit of berry value, and how fast it weakens on the way home
    },

    layout: (
        legend: { 'N': "nest", '*': "bush", 'a': "ant", 'E': "entrance" },
        cells: { 'x': { "soil": 1 } },
        levels: [
            [ // level 0  surface
                "................................",
                "................................",
                "...*.......................*....",
                "................................",
                "................................",
                ".........*......................",
                "...........................*....",
                "................................",
                "................................",
                "................E...............",
                "................................",
                "....*...........................",
                ".........................*......",
                "................................",
                "................................",
                "...........*....................",
                "................................",
                "................................" ],
            [ // level 1
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" ],
            [ // level 2
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" ],
            [ // level 3  granary
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxx.........xxxxxxxxxxx",
                "xxxxxxxxxxxx.aaa.aaa.xxxxxxxxxxx",
                "xxxxxxxxxxxx....N....xxxxxxxxxxx",
                "xxxxxxxxxxxx..a...a..xxxxxxxxxxx",
                "xxxxxxxxxxxx.........xxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" ],
            [ // level 4
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" ],
            [ // level 5  deep chamber
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxx.......xxxxxxxxxxxx",
                "xxxxxxxxxxxxx.......xxxxxxxxxxxx",
                "xxxxxxxxxxxxx.......xxxxxxxxxxxx",
                "xxxxxxxxxxxxx.......xxxxxxxxxxxx",
                "xxxxxxxxxxxxx.......xxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" ]
        ],
    ),

    fsms: {
        "nest": ( initial: "Open", states: { "Open": () }, transitions: [] ),

        "bush": (
            initial: "Ripe",
            transitions: [
                (from: "Ripe", to: "Bare", when: "me.berries == 0"),
                (from: "Bare", to: "Ripe", when: "me.berries > 0"),
            ],
        ),

        "ant": (
            initial: "Active",
            states: {
                "Active": (
                    remember: true,
                    initial: "Nurse",
                    rules: [
                        (name: "grow_older", then: [ Add("age", "1") ]),
                    ],
                    states: {
                        // Young ants stay home and turn food into brood.
                        "Nurse": (rules: [
                            (name: "stay_home", when: "sense.moving", then: [ MoveToward("nest") ]),
                            (name: "raise_brood", target: Nearest("nest"),
                             when: r#"it.dist <= 1 && it.food >= p.egg_cost + p.brood_reserve && sense.summer && roll * 100 < p.lay_chance * (if p.brood_warmth == 1 { sense.warmth } else { 100 })"#,
                             then: [ On(It, [ Need("food", "p.egg_cost"), Add("food", "-p.egg_cost"), Add("born", "1") ]),
                                     Spawn("ant"), Emit("born") ]),
                        ]),
                        "Forager": (
                            initial: "Ready",
                            states: {
                                // Waiting at the entrance.
                                "Ready": (rules: [ (name: "wait_at_entrance", when: "sense.moving", then: [ MoveToward("entrance") ]) ]),
                                // Out looking: climb the scent, sometimes wander.
                                "Search": (
                                    enter: [ Set("searched", "0") ],
                                    rules: [
                                        (name: "explore", when: "sense.moving && roll < p.noise", then: [ Wander ]),
                                        (name: "follow_scent", when: "sense.moving", then: [ ClimbField("scent") ]),
                                        // No scent to climb: head outward, like real scouts (a correlated walk away from home).
                                        (name: "no_scent_here", when: "sense.moving", then: [ MoveAway("nest") ]),
                                        (name: "search_time", then: [ Add("searched", "1") ]),
                                        (name: "pick_berry", target: NearestIn("bush", "Ripe"), when: "it.dist <= 1",
                                         then: [ On(It, [ Need("berries", "1"), Add("berries", "-1") ]),
                                                 // Better food, stronger trail (Pharaoh's ants, Lasius niger): the colony concentrates on the best bushes.
                                                 Set("load", "it.value"), Set("trail", "min(p.scent_max, it.value * p.trail_per_value)"), Goto("Carry") ]),
                                    ],
                                ),
                                // Loaded: walk home and mark the way.
                                "Carry": (rules: [
                                    (name: "walk_home", when: "sense.moving", then: [ MoveToward("nest") ]),
                                    (name: "mark_trail", when: "me.z == 0 && me.trail > 0",
                                     then: [ SetField("scent", r#"min(p.scent_max, field("scent") + me.trail)"#),
                                             Set("trail", "max(0, me.trail - p.trail_step)") ]),
                                    (name: "deliver", target: Nearest("nest"), when: "it.dist <= 1",
                                     then: [ On(It, [ Add("food", "me.load"), Add("income", "me.load") ]),
                                             Set("load", "0"), Goto("Ready"), Emit("delivered") ]),
                                ]),
                            },
                            transitions: [
                                // Interaction rate: enough loaded foragers passing by, or a scout's whim.
                                (from: "Ready", to: "Search",
                                 when: r#"around("ant", "Carry", p.entrance_r) >= p.contacts || roll < p.scout_chance || nearest_prop("nest", "rally", 999, 0) > 0"#),
                                (from: "Search", to: "Ready", when: "me.searched >= p.patience"),
                            ],
                        ),
                    },
                    transitions: [
                        // Response threshold: each ant's own age, lowered when the colony is hungry.
                        (from: "Nurse", to: "Forager",
                         when: "me.threshold >= 0 && me.age >= me.threshold - (if me.store < p.hungry_store { p.hunger_push } else { 0 })"),
                    ],
                ),
                // Winter: cluster in the nest, eat little, wait.
                // Winter: go home, then follow the warmth down through the soil.
                "Dormant": (rules: [
                    (name: "go_home", when: "sense.moving && me.z == 0", then: [ MoveToward("nest") ]),
                    (name: "seek_warmth", when: "sense.moving && me.z > 0", then: [ ClimbField("temp") ]),
                ]),
            },
            transitions: [
                (from: "Active",  to: "Dormant",
                 when: "sense.winter || (p.dormant_below > 0 && sense.warmth < p.dormant_below)"),
                (from: "Dormant", to: "Active",
                 when: "!sense.winter && (p.dormant_below == 0 || sense.warmth >= p.dormant_below)"),
            ],
            rules: [
                (name: "temperament", when: "me.threshold < 0",
                 then: [ Set("threshold", "p.forage_age + rand(p.forage_spread)"),
                         Set("tolerance", "p.starve_at + rand(p.starve_spread)") ]),
                (name: "sense_store", target: Nearest("nest"), then: [ Set("store", "it.food") ]),
                // Food is shared through the colony (trophallaxis): every ant eats from the store.
                (name: "eat", target: Nearest("nest"),
                 when: r#"(p.cold_metabolism == 0 || in_state("Dormant")) && sense.clock % (if in_state("Dormant") { p.winter_meal_every } else { p.meal_every }) == me.id % p.meal_every"#,
                 then: [ On(It, [ Need("food", "1"), Add("food", "-1") ]), Set("hunger", "0") ]),
                (name: "go_hungry", when: "me.store == 0", then: [ Add("hunger", "1") ]),
                // -1 until temperament has run (rules see the start of the tick).
                (name: "starve", when: "me.tolerance >= 0 && me.hunger >= me.tolerance", then: [ Emit("starved"), Despawn(Me) ]),
                // Cold metabolism: appetite builds with warmth; a full appetite is one meal.
                (name: "appetite", when: r#"p.cold_metabolism == 1 && !in_state("Dormant")"#,
                 then: [ Add("appetite", "max(p.cold_floor, sense.warmth)") ]),
                (name: "eat_by_warmth", target: Nearest("nest"),
                 when: r#"p.cold_metabolism == 1 && !in_state("Dormant") && me.appetite >= 100 * p.meal_every"#,
                 then: [ On(It, [ Need("food", "1"), Add("food", "-1") ]), Set("hunger", "0"),
                         Add("appetite", "-100 * p.meal_every") ]),
                // Body heat: ants underground warm the soil around them (it diffuses on).
                (name: "body_heat", when: "me.z > 0", then: [ AddField("temp", "p.body_heat") ]),
            ],
        ),
    },

    rules: [
        (name: "regrow", for: "bush",
         when: "sense.summer && sense.clock % p.regrow_every == 0 && me.berries < p.bush_max",
         then: [ Add("berries", "1") ]),
        // Each bush is a little better or worse than average, for life.
        (name: "bush_quality", for: "bush", when: "me.quality < 0",
         then: [ Set("quality", "p.quality_min + rand(p.quality_spread)") ]),
        // A berry is worth 2 × berry_value × quality × the land's ripeness (from the seasons environment),
        // so on average about berry_value, from 1 up to ~3×.
        (name: "ripen", for: "bush",
         then: [ Set("value", "max(1, 2 * p.berry_value * max(0, me.quality) * sense.ripeness / 10000)") ]),
        (name: "provision", for: "nest", when: "sense.first_tick", then: [ Set("food", "p.start_food") ]),
        (name: "rally_fades", for: "nest", when: "me.rally > 0", then: [ Add("rally", "-1") ]),
        (name: "spoil", for: "nest",
         when: "p.spoil_every > 0 && me.food > p.spoil_above && sense.clock % p.spoil_every == 0 && field(\"temp\") > 1500",
         then: [ Add("food", "-1"), Add("spoiled", "1"), Emit("spoiled") ]),
        (name: "rot", for: "nest", when: "me.spoiled > 0 && sense.clock % p.rot_every == 0", then: [ Add("spoiled", "-1") ]),
    ],

    // What the player can do (buttons on the stage). The nest acts for the colony.
    actions: [
        (name: "lay_egg", for: "nest", when: "me.food >= p.lay_cost",
         then: [ Need("food", "p.lay_cost"), Add("food", "-p.lay_cost"), Add("born", "1"), Spawn("ant"), Emit("laid") ]),
        (name: "rally", for: "nest", when: "me.rally == 0", then: [ Set("rally", "p.rally_ticks"), Emit("rally") ]),
        (name: "warm", for: "nest", when: "me.food >= p.warm_cost",
         then: [ Need("food", "p.warm_cost"), Add("food", "-p.warm_cost"), AddField("temp", "p.warm_heat"), Emit("warmed") ]),
    ],

    end: [ (when: "count.ant == 0", result: "extinct") ],
)
