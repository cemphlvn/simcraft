            "Bo.c",
            "..$.",
            "....",
            "....",
            "G...",
            "....",
            "B.cB",
            "....",
            "....",
            "n...",
            "..$.",
            "....",
            "..cB",
            "....",
            "....",
            "....",
            "$...",
            "....",
            "c.oB",
            ".$..",
            "....",
            "....",
            "n...",
            "....",
            "..c.",
            "$...",
            "....",
            "....",
            "..$.",
            "....",
            "BBc.",
            "....",
            "....",
            "....",
            "....",
            "..n.",
            "...B",
            "..$.",
            "....",
            "....",
            "..$.",
            "....",
            ".BB.",
            "..$.",
            "....",
            "....",
            "....",
            "....",
            "....",
            "....",
        ],
    ),

    fsms: {
        "car": (
            initial: "Driving",
            states: { "Driving": (), "Dashing": (), "Airborne": (), "Wobbly": () },
            transitions: [
                (from: "Dashing",  to: "Driving", when: "me.timer == 0"),
                (from: "Airborne", to: "Driving", when: "me.timer == 0", then: [ Emit("landed") ]),
                (from: "Wobbly",   to: "Driving", when: "me.timer == 0"),
            ],
        ),
    },

    rules: [
        // -1: not set yet (props cannot read params): the first tick fills the tank and takes the start position.
        (name: "start", for: "car", when: "me.fuel < 0", then: [ Set("fuel", "p.max_fuel"), Set("lane_to", "me.x") ]),
        (name: "count_down", for: "car", when: "me.timer > 0", then: [ Add("timer", "-1") ]),
        (name: "stride", for: "car", then: [ Set("stride", r#"if in_state("Dashing") { 2 } else { 1 }"#) ]),
        // Forward, and across towards the chosen position (at most shift_step positions a tick).
        (name: "drive", for: "car", when: "me.over == 0 && me.lane_to >= 0", then: [ MoveBy("if me.lane_to > me.x { min(p.shift_step, me.lane_to - me.x) } else if me.lane_to < me.x { -min(p.shift_step, me.x - me.lane_to) } else { 0 }", "me.stride") ]),
        (name: "burn", for: "car", when: "me.over == 0 && me.fuel > 0 && pace(p.burn)", then: [ Add("fuel", "-1") ]),
        // Hazards: cones and oil are cleared by a jump or a dash; walls by nothing. A hit smashes the thing away (the
        // car goes through), costs a life and leaves the car wobbly for a moment.
        (name: "hit_cone", for: "car", target: Nearest("cone"), when: r#"it.dist == 0 && in_state("Driving")"#,
         then: [ Despawn(Nearest("cone")), Add("lives", "-1"), Set("timer", "p.wobble_ticks"), Goto("Wobbly"), Emit("crashed") ]),
        (name: "hit_wall", for: "car", target: Nearest("barrier"), when: r#"it.dist == 0 && !in_state("Wobbly")"#,
         then: [ Despawn(Nearest("barrier")), Add("lives", "-1"), Set("timer", "p.wobble_ticks"), Goto("Wobbly"), Emit("crashed") ]),
        // Oil throws the car one position over (and that becomes where it is headed).
        (name: "skid", for: "car", target: Nearest("oil"), when: r#"it.dist == 0 && in_state("Driving")"#,
         then: [ Set("lane_to", "if me.x == 0 { 1 } else if me.x == p.lanes - 1 { me.x - 1 } else if roll < 50 { me.x - 1 } else { me.x + 1 }"), Emit("skidded") ]),
        // Being there: pickups, fuel, gates.
        (name: "coin", for: "car", target: Nearest("coin"), when: "it.dist == 0",
         then: [ Despawn(Nearest("coin")), Add("coins", "1"), Emit("coin") ]),
        (name: "nitro", for: "car", target: Nearest("nitro"), when: "it.dist == 0",
         then: [ Despawn(Nearest("nitro")), Add("nitro", "1"), Emit("nitro") ]),
        (name: "refuel", for: "car", target: Nearest("fuelpad"), when: "it.dist == 0 && me.fuel < p.max_fuel",
         then: [ Set("fuel", "min(p.max_fuel, me.fuel + p.refill)"), Emit("refueled") ]),
        (name: "stamp", for: "car", target: Nearest("gate"), when: "it.dist == 0 && it.stamped == 0",
         then: [ On(It, [ Set("stamped", "1") ]), Add("stamps", "1"), Emit("stamped") ]),
        // The end: out of lives or fuel, or over the line (the car stays, its score counts).
        (name: "wreck", for: "car", when: "me.over == 0 && (me.lives <= 0 || me.fuel == 0)", then: [ Emit("wrecked"), Despawn(Me) ]),
        (name: "finish", for: "car", when: "me.over == 0 && me.y >= p.finish", then: [ Set("over", "1"), Emit("finished"), Spawn("trophy") ]),
    ],

    // What the player does. Left hand: 1 2 3 4 = positions (goto lane 0..3), thumb on space = jump. Right hand:
    // Enter = dash.
    actions: [
        (name: "goto", for: "car", args: ["lane"],
         when: r#"arg.lane >= 0 && arg.lane < p.lanes && arg.lane != me.lane_to"#,
         then: [ Set("lane_to", "arg.lane"), Emit("shift") ]),
        (name: "jump", for: "car", when: r#"in_state("Driving")"#,
         then: [ Set("timer", "p.air_ticks"), Goto("Airborne"), Emit("jumped") ]),
        (name: "dash", for: "car", when: r#"me.nitro > 0 && in_state("Driving")"#,
         then: [ Need("nitro", "1"), Add("nitro", "-1"), Set("timer", "p.dash_ticks"), Goto("Dashing"), Emit("dashed") ]),
    ],

    score: "me.coins * p.coin_score + me.stamps * p.gate_score + me.y",

    end: [
        (when: "count.trophy > 0", result: "finished"),
        (when: "count.car == 0", result: "wrecked"),
    ],
)
