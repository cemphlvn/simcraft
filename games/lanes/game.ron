#![enable(implicit_some)]
// Experimental: an example game, still changing (first person, positions as the core mechanic).
// Lanes. A first-person car game about positions: the car drives itself down a four-lane road, and 1 2 3 4 are the
// four positions across it. Press one and the car glides there, lane by lane (anything on the way still counts).
// Where you are decides what happens: coins, fuel pads and checkpoint gates are collected by being there; walls
// leave one position free. Left thumb on space: jump (clears cones and oil, not walls). Right hand on Enter: dash
// (two cells a tick, through cones and oil). Hitting something never stops the car: it smashes through, loses a
// life and wobbles for a moment (it can still steer, and cannot be hit again until it steadies). How the move between positions *feels* is tuned in track.ron (`switch`).
// The track is the layout below: '.' road, 'c' cone, 'B' wall, 'o' oil, '$' coin, 'n' nitro, 'F' fuel pad,
// 'G' checkpoint gate, 'P' the car.
Game(
    name: "lanes",
    perception: Senses,

    kinds: {
        "car":     (glyph: 'A', fsm: "car",
                    props: { "fuel": -1, "lives": 3, "nitro": 1, "coins": 0, "stamps": 0, "stride": 1, "timer": 0,
                             "over": 0, "lane_to": -1 },
                    glyphs: { "Dashing": '>', "Airborne": '^', "Wobbly": '~' }),
        "cone":    (glyph: 'c'),
        "barrier": (glyph: 'B'),
        "oil":     (glyph: 'o'),
        "coin":    (glyph: '$'),
        "nitro":   (glyph: 'n'),
        "fuelpad": (glyph: 'F'),
        "gate":    (glyph: 'G', props: { "stamped": 0 }),
        "trophy":  (glyph: '*'),
    },

    params: {
        "lanes": 4,
        "shift_step": 1,             // positions crossed per tick when moving to another position
        "finish": 458,
        "max_fuel": 45, "burn": 1, "refill": 45,
        "dash_ticks": 10,
        "air_ticks": 7,
        "wobble_ticks": 14,          // after a hit: steer freely, cannot be hit again
        "gate_score": 50, "coin_score": 10,
    },

    layout: (
        legend: { 'P': "car", 'c': "cone", 'B': "barrier", 'o': "oil", '$': "coin", 'n': "nitro", 'F': "fuelpad",
                  'G': "gate" },
