// GUMBALL: a merge-drop game. Drag to aim, let go to drop a gumball into the jar; two of the same size that touch
// merge into the next size up. The game ends when the pile stays over the rim. Every number that shapes how it
// feels is here; `cargo test -p sim-mobile gumball_eval -- --nocapture` plays it with the autopilot (EVALS.md).
// Units: metres, seconds, kilograms. The jar stands on y = 0, centred on x = 0; the balls live in the plane z = 0.
(
    physics: (
        gravity: 9.81,
        substeps: 6,
    ),
    jar: (
        // Inside the glass (m).
        width: 3.0,
        height: 4.2,
        wall: 0.12,
        // A ball still over this height (m above the floor) this long after it last moved fast is over the rim.
        rim: 3.75,
        over_time: 1.5,
        friction: 0.25,
        restitution: 0.05,
    ),
    balls: (
        density: 900.0,
        // Density falls with size as (smallest / radius)^this: 0 is real sugar (mass grows with volume), 2 makes mass
        // grow only with the radius, so a big ball does not crush the small ones under it.
        density_falloff: 0.0,
        friction: 0.3,
        restitution: 0.12,
        // Each size is this many times the one before, from the smallest radius (m).
        smallest: 0.14,
        growth: 1.26,
        // How many sizes there are; two of the largest that merge vanish for a bonus.
        sizes: 11,
        // A new ball is one of the smallest this many sizes, chosen by the seeded dice.
        drop_sizes: 5,
        // Points for making a ball of each size (the smallest is never made, so its points are never paid).
        points: [0, 1, 3, 6, 10, 15, 21, 28, 36, 45, 55],
        // Two of the largest merging pay this.
        bonus: 100,
        // Sugar colours, smallest first (sRGB).
        colours: [0xff5c7a, 0xffb02e, 0xffe14d, 0x7bdc5a, 0x37c6c0, 0x4f8cff, 0x9a6bff, 0xff7ad9, 0xff6b3d, 0xf4f1ea, 0xffd700],
    ),
    feel: (
        // Seconds between drops (the next ball waits this long after one leaves the hand).
        reload: 0.45,
        // The dropper's height above the rim (m), and how far the merged ball pops up (m/s).
        drop_above: 0.55,
        merge_pop: 1.2,
        seed: 7,
    ),
    camera: (
        fov: 34.0,
        margin: 0.3,
    ),
)
