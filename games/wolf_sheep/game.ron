#![enable(implicit_some)]
// Wolf / Sheep — the designer's file.
// Expressions are Rhai and can see:
//   me.<prop> me.x me.y me.state me.kind me.id
//   p.<param>          (the params below; engine.toml overrides them)
//   near.<kind>        (distance to the nearest of that kind; 9999 if none)
//   count.<kind>  tick  roll (0..99, a deterministic die per rule)
Game(
    name: "wolf_sheep",
    // Written before senses existed: every expression sees the whole world.
    perception: Direct,

    kinds: {
        "sheep": (glyph: 's', props: { "hunger": 0 }, fsm: "sheep"),
        "wolf":  (glyph: 'W', props: { "hunger": 0 }, fsm: "wolf"),
    },

    // Knobs the designer exposes. The operator turns them in engine.toml [params].
    params: {
        "starve_at": 30,
        "wolf_hunt_at": 12,
        "sheep_alert": 3,
        "sheep_breed_chance": 10,
        "sheep_cap": 90,
        "graze_gain": 2,
        "wolf_breed_chance": 3,
    },

    fsms: {
        "wolf": (
            initial: "Roam",
            transitions: [
                (from: "Roam", to: "Hunt", when: "me.hunger >= p.wolf_hunt_at"),
                (from: "Hunt", to: "Roam", when: "me.hunger == 0"),
            ],
        ),
        "sheep": (
            initial: "Graze",
            transitions: [
                (from: "Graze", to: "Flee",  when: "near.wolf <= p.sheep_alert"),
                (from: "Flee",  to: "Graze", when: "near.wolf > p.sheep_alert"),
            ],
        ),
    },

    rules: [
        // --- everyone ---
        (name: "metabolism", for: "*", then: [ Add("hunger", "1") ]),
        (name: "starvation", for: "*", when: "me.hunger >= p.starve_at",
         then: [ Despawn(Me), Emit("starved") ]),

        // --- sheep ---
        // Layer B example: when the declarative actions aren't enough, a Rhai script returns effects.
        (name: "graze", for: "sheep", state: "Graze",
         script: r#"
            if roll < 50 && me.hunger > 0 {
                [ #{ op: "add", prop: "hunger", value: -p.graze_gain } ]
            } else { [] }
         "#),
        (name: "sheep_wander", for: "sheep", state: "Graze", then: [ Wander ]),
        (name: "sheep_flee",   for: "sheep", state: "Flee",  then: [ MoveAway("wolf") ]),
        (name: "sheep_breeding", for: "sheep", state: "Graze",
         when: "roll < p.sheep_breed_chance && count.sheep < p.sheep_cap",
         then: [ Spawn("sheep"), Emit("born") ]),

        // --- wolf ---
        (name: "wolf_roam", for: "wolf", state: "Roam", then: [ Wander ]),
        (name: "wolf_hunt", for: "wolf", state: "Hunt", when: "near.sheep > 0",
         then: [ MoveToward("sheep") ]),
        // Atomic group: if two wolves target the same sheep, the second gets a "conflict" and stays hungry.
        (name: "predation", for: "wolf", when: "near.sheep <= 1 && me.hunger > 2",
         then: [ Despawn(Nearest("sheep")), Set("hunger", "0"), Emit("kill") ]),
        // A wolf that just ate (well fed) sometimes breeds.
        (name: "wolf_breeding", for: "wolf", when: "me.hunger == 0 && roll < p.wolf_breed_chance",
         then: [ Spawn("wolf"), Emit("born") ]),
    ],

    // What an agent may ask a wolf to do.
    actions: [
        (name: "move", for: "wolf", args: ["dx", "dy"], then: [ Move("arg.dx", "arg.dy") ]),
    ],
)
