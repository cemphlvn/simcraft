#![enable(implicit_some)]
// Experimental: highway_surfers (GDD.md: the design; EVALS.md, FEEL.md: the evidence).
// The highway is a river of moving platforms. Five columns: lanes 0 and 1 carry oncoming traffic (toward the
// camera), 2 is the median barrier, lanes 3 and 4 flow with you. Everything moves continuously (`motion`: fine units,
// 1000 to a cell; one cell is a car length; velocities integrated every tick at 60 a second).
// You ride a roof (mounted: carried by it). A leap is physics: you leave with the roof's speed, fly on gravity and
// land where your falling height meets a roof top (within `land_band` below it: a forgiving catch). A hop peaks below
// a truck's roof (you hit its side); a jump clears it. The barrier stops a sideways leap, except beside a ramp: then
// it is the BIG JUMP, over the median to the other side, where everything comes at you and scores three times.
// On the asphalt you run slower than every lane: whatever reaches you hits you. Bridges hit a head that high.
Game(
    name: "highway_surfers",
    perception: Senses,

    kinds: {
        "surfer":  (glyph: 'S', fsm: "surfer", motion: (size: (300, 400), gravity: 7),
                    props: { "started": 0, "lane_to": -1, "timer": 0, "guard": 0, "lives": 3, "coins": 0,
                             "points": 0, "combo": 0, "best": 0, "over": 0 },
                    glyphs: { "Air": '^', "Ducking": '_', "Ground": 's' },
                    senses: {
                        // The roof under my centre (0 = asphalt) and how high its top is.
                        "roof": r#"if under("truck") > 0 { under("truck") } else if under("van") > 0 { under("van") } else { under("car") }"#,
                        "roof_top": r#"prop_of(if under("truck") > 0 { under("truck") } else if under("van") > 0 { under("van") } else { under("car") }, "top", 0)"#,
                        // Traffic whose footprint overlaps mine (it hits me on the asphalt).
                        "hit": r#"touching("car") + touching("van") + touching("truck")"#,
                        "clearance": r#"nearest_prop("bridge", "clearance", 0, 99999)"#,
                        // The oncoming side scores three times.
                        "side": "if me.x < 2 { 3 } else { 1 }",
                    }),
        "car":     (glyph: 'c', motion: (size: (620, 900)), props: { "top": 500 }),
        "van":     (glyph: 'v', motion: (size: (660, 950)), props: { "top": 800 }),
        "truck":   (glyph: 'T', motion: (size: (720, 980)), props: { "top": 1150 }),
        // Traffic exists only around the surfer: a director per lane rides `at` cells ahead of it (another behind)
        // and sends a vehicle in when there is room; vehicles far from the surfer leave (`far`).
        "director": (glyph: 'd', hidden: true, motion: (size: (100, 100)), props: { "at": 0, "next": 0, "gap": 3 },
                    senses: { "sy": r#"nearest_prop("surfer", "py", 9999, 0)"#,
                              "room": r#"min(min(min(ahead("car"), ahead("van")), ahead("truck")), min(min(behind("car"), behind("van")), behind("truck")))"#,
                              "cars": "if me.x < 2 { p.cars_oncoming } else if me.x == 3 { p.cars_3 } else { p.cars_4 }",
                              "vans": "if me.x < 2 { p.vans_oncoming } else if me.x == 3 { p.vans_3 } else { p.vans_4 }" }),
        // A ramp on the median: beside it, a sideways leap toward the median is the BIG JUMP.
        "ramp":    (glyph: 'R'),
        "bridge":  (glyph: '=', props: { "clearance": 1400 }),
        "coin":    (glyph: '$', props: { "h": 1 }),
        "trophy":  (glyph: '*'),
    },

    params: {
        "lanes": 5, "median": 2,
        // Lane speeds, fine units a tick (60 a second: 167 = 10 car lengths a second). Oncoming lanes are negative.
        "v_0": -200, "v_1": -150, "v_3": 167, "v_4": 125, "foot_v": 62,
        // Leaps: upward speed of a hop (0.38 s of air), a jump (0.61 s), the BIG JUMP (0.71 s, two lanes over).
        "hop_v": 80, "jump_v": 128, "big_v": 150,
        // A leap forward or back adds this to the roof's speed (fine units a tick: about 1.5 car lengths in a hop,
        // 2.4 in a vault); walking along a roof.
        "leap_vy": 65, "walk_v": 40,
        // A landing counts from a roof's top down to this far below it (a forgiving catch; deeper is its side).
        "land_band": 300,
        // Steering across to a lane: aim at steer_k % of the distance left a tick, at most steer_max, changing speed
        // by at most steer_acc a tick (eases in and out: one lane in 21 ticks, no overshoot).
        "steer_k": 20, "steer_acc": 8, "steer_max": 70,
        "body": 490, "duck_body": 250,           // head height above the feet, standing and ducking
        "duck_ticks": 30, "wobble_ticks": 90,
        // What directors send, % cars and vans (the rest trucks), and the room they leave (cells).
        "cars_oncoming": 70, "vans_oncoming": 20, "cars_3": 55, "vans_3": 30, "cars_4": 25, "vans_4": 30,
        "min_gap": 2, "gap_spread": 5, "far": 60,
        "road_end": 3190, "finish": 3140,
        "coin_score": 10, "combo_bonus": 5,
    },

    fsms: {
        "surfer": (
            layers: {
                // Where the body is: on a roof (riding it), in the air (on gravity), on the asphalt.
                "Body": (
                    initial: "Roof",
                    states: {
                        "Roof": (initial: "Riding", states: { "Riding": (), "Ducking": () },
                                 transitions: [ (from: "Ducking", to: "Riding", when: "me.timer == 0") ]),
                        "Air": (initial: "Hopping", states: { "Hopping": (), "Jumping": (), "Big": () }),
                        "Ground": (),
                    },
                    transitions: [
                        // Landing: falling onto the roof under me, from its top to `land_band` below it.
                        (from: "Air", to: "Roof",
                         when: "me.vh < 0 && sense.roof > 0 && me.ph <= sense.roof_top && me.ph >= sense.roof_top - p.land_band",
                         then: [ Set("ph", "sense.roof_top"), Set("vh", "0"), Set("vy", "0"), Set("mount", "sense.roof"),
                                 Add("combo", "1"), Emit("landed") ]),
                        // Deeper than that while over it: I flew into its side (a hop does not reach a truck).
                        (from: "Air", to: "Ground", when: "sense.roof > 0 && me.ph < sense.roof_top - p.land_band",
                         then: [ Set("vy", "p.foot_v"), Set("lane_to", "me.x"), Set("combo", "0"), Emit("bonked") ]),
                        // Down on the asphalt.
                        (from: "Air", to: "Ground", when: "me.ph == 0 && me.vh == 0",
                         then: [ Set("vy", "p.foot_v"), Set("combo", "0"), Emit("fell") ]),
                        // The roof left without me.
                        (from: "Roof", to: "Ground", when: "me.started == 1 && me.mount > 0 && sense.roof == 0",
                         then: [ Set("mount", "0"), Set("vy", "p.foot_v"), Set("combo", "0"), Emit("fell") ]),
                    ],
                ),
                // After a hit: invulnerable for a moment (the body blinks).
                "Guard": (
                    initial: "Ok",
                    states: { "Ok": (), "Wobbly": () },
                    transitions: [
                        (from: "Ok", to: "Wobbly", when: "me.guard > 0"),
                        (from: "Wobbly", to: "Ok", when: "me.guard == 0"),
                    ],
                ),
            },
        ),
    },

    rules: [
        // The first tick: the surfer starts on a car of its own; the next, it gets on it.
        (name: "start", for: "surfer", when: "me.started == 0",
         then: [ Spawn("car"), Set("started", "1"), Set("lane_to", "me.x"), Set("ph", "500") ]),
        (name: "get_on", for: "surfer", state: "Roof", when: "me.mount == 0 && sense.roof > 0",
         then: [ Set("mount", "sense.roof"), Set("ph", "sense.roof_top"), Set("vh", "0") ]),
        (name: "count_down", for: "surfer", when: "me.timer > 0", then: [ Add("timer", "-1") ]),
        (name: "guard_down", for: "surfer", when: "me.guard > 0", then: [ Add("guard", "-1") ]),
        // Across (in the air, and on after landing): steer to the lane's centre, easing in and out, and settle there.
        (name: "steer_across", for: "surfer",
         when: "me.lane_to >= 0 && !((me.lane_to * 1000 + 500 - me.px) * (me.lane_to * 1000 + 500 - me.px) < 36 && me.vx * me.vx <= p.steer_acc * p.steer_acc) && (me.px != me.lane_to * 1000 + 500 || me.vx != 0)",
         then: [ Set("vx", "me.vx + clamp(clamp((me.lane_to * 1000 + 500 - me.px) * p.steer_k / 100, -p.steer_max, p.steer_max) - me.vx, -p.steer_acc, p.steer_acc)") ]),
        (name: "settle_across", for: "surfer",
         when: "(me.lane_to * 1000 + 500 - me.px) * (me.lane_to * 1000 + 500 - me.px) < 36 && me.vx * me.vx <= p.steer_acc * p.steer_acc && (me.px != me.lane_to * 1000 + 500 || me.vx != 0)",
         then: [ Set("vx", "0"), Set("px", "me.lane_to * 1000 + 500") ]),
        // The top of the BIG JUMP (the camera slows time here).
        (name: "apex", for: "surfer", state: "Big", when: "me.ph > 0 && me.vh <= 0 && me.vh > -7", then: [ Emit("apex") ]),
        (name: "run", for: "surfer", state: "Ground", when: "me.over == 0 && me.vy != p.foot_v", then: [ Set("vy", "p.foot_v") ]),
        // Points: distance ridden, three times on the oncoming side.
        (name: "points", for: "surfer", state: "Roof", when: "me.over == 0",
         then: [ Add("points", "sense.side * abs(prop_of(me.mount, \"vy\", 0))") ]),
        (name: "best_combo", for: "surfer", when: "me.combo > me.best", then: [ Set("best", "me.combo") ]),
        // Hits. On the asphalt, a vehicle that reaches me; anywhere, a bridge lower than my head.
        (name: "run_over", for: "surfer", state: "Ground", when: "sense.hit > 0 && me.ph < 300 && me.guard == 0",
         then: [ Add("lives", "-1"), Set("guard", "p.wobble_ticks"), Emit("crashed") ]),
        (name: "bridge_hit", for: "surfer",
         when: r#"me.ph + (if in_state("Ducking") { p.duck_body } else { p.body }) >= sense.clearance && me.guard == 0 && !in_state("Ground")"#,
         then: [ Add("lives", "-1"), Set("guard", "p.wobble_ticks"), Set("mount", "0"), Set("vy", "p.foot_v"),
                 Set("lane_to", "me.x"), Set("combo", "0"), Goto("Ground"), Emit("crashed") ]),
        // Coins float at a height (h: 700 fine units at 1, 1600 at 3); caught within reach of the chest.
        (name: "coin", for: "surfer", target: Nearest("coin"),
         when: "it.dist == 0 && (it.h * 450 - me.ph) * (it.h * 450 - me.ph) <= 400 * 400",
         then: [ Despawn(Nearest("coin")), Add("coins", "1"), Emit("coin") ]),
        (name: "wreck", for: "surfer", when: "me.over == 0 && me.lives <= 0", then: [ Emit("wrecked"), Despawn(Me) ]),
        (name: "finish", for: "surfer", when: "me.over == 0 && me.y >= p.finish",
         then: [ Set("over", "1"), Set("vy", "0"), Set("mount", "0"), Emit("finished"), Spawn("trophy") ]),

        // Traffic: at its lane's speed from its first tick; gone at the end of the road or far from the surfer.
        (name: "drive_car", for: "car", when: "me.vy == 0 && me.y < p.road_end",
         then: [ Set("vy", "if me.x == 0 { p.v_0 } else if me.x == 1 { p.v_1 } else if me.x == 3 { p.v_3 } else { p.v_4 }") ]),
        (name: "drive_van", for: "van", when: "me.vy == 0 && me.y < p.road_end",
         then: [ Set("vy", "if me.x == 0 { p.v_0 } else if me.x == 1 { p.v_1 } else if me.x == 3 { p.v_3 } else { p.v_4 }") ]),
        (name: "drive_truck", for: "truck", when: "me.vy == 0 && me.y < p.road_end",
         then: [ Set("vy", "if me.x == 0 { p.v_0 } else if me.x == 1 { p.v_1 } else if me.x == 3 { p.v_3 } else { p.v_4 }") ]),
        (name: "exit_car", for: "car", when: "me.y >= p.road_end || me.y <= 0 || near.surfer > p.far", then: [ Despawn(Me) ]),
        (name: "exit_van", for: "van", when: "me.y >= p.road_end || me.y <= 0 || near.surfer > p.far", then: [ Despawn(Me) ]),
        (name: "exit_truck", for: "truck", when: "me.y >= p.road_end || me.y <= 0 || near.surfer > p.far", then: [ Despawn(Me) ]),
        // Directors: ride along with the surfer; when there is room around them, send the next vehicle in.
        (name: "direct", for: "director", when: "sense.sy > 0", then: [ Set("py", "sense.sy + me.at * 1000"), Set("next", "rand(100)") ]),
        (name: "send_car", for: "director", when: "sense.sy > 0 && sense.room > me.gap * 1000 && me.next < sense.cars",
         then: [ Spawn("car"), Set("gap", "p.min_gap + rand(p.gap_spread)") ]),
        (name: "send_van", for: "director", when: "sense.sy > 0 && sense.room > me.gap * 1000 && me.next >= sense.cars && me.next < sense.cars + sense.vans",
         then: [ Spawn("van"), Set("gap", "p.min_gap + rand(p.gap_spread)") ]),
        (name: "send_truck", for: "director", when: "sense.sy > 0 && sense.room > me.gap * 1000 && me.next >= sense.cars + sense.vans",
         then: [ Spawn("truck"), Set("gap", "p.min_gap + rand(p.gap_spread)") ]),
    ],

    // What the player does (GDD: Controls). A swipe is one of these; the track tries them in order.
    //   leap(dx, dy): a lane over (never onto the median), forward (dy 1) or back (-1) or straight across (0)
    //   vault(dy): a long leap straight forward or back          jump: straight up (a tap)
    //   big_jump(dir): over the median, only beside a ramp        steer(dir): a jump one lane over, in the air
    //   walk(dy): along the roof while held (0 stops)             crouch / stand: hold to pass under bridges
    // Leaving a roof keeps its speed.
    actions: [
        (name: "leap", for: "surfer", args: ["dx", "dy"],
         when: r#"(arg.dx == 1 || arg.dx == -1) && arg.dy * arg.dy <= 1 && me.x + arg.dx >= 0 && me.x + arg.dx < p.lanes && me.x + arg.dx != p.median && (in_state("Roof") || in_state("Ground"))"#,
         then: [ Set("lane_to", "me.x + arg.dx"), Set("vh", "p.hop_v"),
                 Set("vy", "(if me.mount > 0 { prop_of(me.mount, \"vy\", 0) } else { me.vy }) + arg.dy * p.leap_vy"), Set("mount", "0"),
                 Goto("Hopping"), Emit("hopped") ]),
        (name: "vault", for: "surfer", args: ["dy"],
         when: r#"(arg.dy == 1 || arg.dy == -1) && (in_state("Roof") || in_state("Ground"))"#,
         then: [ Set("vh", "p.jump_v"),
                 Set("vy", "(if me.mount > 0 { prop_of(me.mount, \"vy\", 0) } else { me.vy }) + arg.dy * p.leap_vy"), Set("mount", "0"),
                 Goto("Jumping"), Emit("vaulted") ]),
        (name: "big_jump", for: "surfer", args: ["dir"],
         when: r#"(arg.dir == 1 || arg.dir == -1) && me.x + arg.dir == p.median && near.ramp <= 2 && (in_state("Roof") || in_state("Ground"))"#,
         then: [ Set("lane_to", "me.x + 2 * arg.dir"), Set("vh", "p.big_v"),
                 Set("vy", "if me.mount > 0 { prop_of(me.mount, \"vy\", 0) } else { me.vy }"), Set("mount", "0"),
                 Goto("Big"), Emit("big_jump") ]),
        (name: "steer", for: "surfer", args: ["dir"],
         when: r#"(arg.dir == 1 || arg.dir == -1) && me.x + arg.dir >= 0 && me.x + arg.dir < p.lanes && me.x + arg.dir != p.median && in_state("Jumping") && me.lane_to == me.x"#,
         then: [ Set("lane_to", "me.x + arg.dir"), Emit("steered") ]),
        (name: "jump", for: "surfer", when: r#"in_state("Roof") || in_state("Ground")"#,
         then: [ Set("vh", "p.jump_v"), Set("vy", "if me.mount > 0 { prop_of(me.mount, \"vy\", 0) } else { me.vy }"),
                 Set("mount", "0"), Goto("Jumping"), Emit("jumped") ]),
        (name: "walk", for: "surfer", args: ["dy"],
         when: r#"arg.dy * arg.dy <= 1 && in_state("Roof") && me.vy != arg.dy * p.walk_v"#,
         then: [ Set("vy", "arg.dy * p.walk_v") ]),
        (name: "crouch", for: "surfer", when: r#"in_state("Riding")"#,
         then: [ Set("timer", "600"), Goto("Ducking"), Emit("ducked") ]),
        (name: "stand", for: "surfer", when: r#"in_state("Ducking")"#, then: [ Set("timer", "0") ]),
    ],

    score: "me.points / 1000 + me.coins * p.coin_score + me.best * p.combo_bonus",

    end: [
        (when: "count.trophy > 0", result: "finished"),
        (when: "count.surfer == 0", result: "wrecked"),
    ],

    // Generated by gen_layout.py (edit the generator, or edit rows by hand): the traffic on the road at the start.
    layout: (
        legend: { 'S': "surfer", 'A': ("director", { "at": 45 }), 'B': ("director", { "at": -20 }),
                  'c': "car", 'v': "van", 'T': "truck", 'R': "ramp",
                  '=': "bridge", '-': ("bridge", { "clearance": 1050 }),
                  'o': ("coin", { "h": 1 }), 'O': ("coin", { "h": 3 }) },
        rows: [
            // rows:begin
            "AA.AA",
            "BB.BB",
            ".....",
            ".....",
            ".....",
            ".....",
            ".....",
            ".....",
            ".....",
