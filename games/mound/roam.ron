#![enable(implicit_some)]
// You are a termite: first person, at termite height. WASD crawls, the mouse looks, shift hurries, space hops,
// walking into a wall climbs it. Left click drops the ball you carry where you look; right click digs one.
// Hold f to smell: the cement pheromone glows where fresh mud is.
Roam(
    assets: ["nature_hd", "mound"],
    you: "you",
    actions: (crawl: "crawl", dig: "dig", drop: "drop", reach: 2.5, carrying: "carrying"),
    materials: {
        1: (image: "laterite", scale: 0.35),     // earth: dry red laterite, macro-photographed
        2: (image: "mud", scale: 0.3),           // mud balls: packed moist clay pellets
    },
    // One continuous, rounded surface through the voxels (the mound looks built of clay, not of cubes).
    surface: Smooth,
    // A macro lens: things blur away from what you look at, the sun casts shadows, the haze glows towards it.
    lens: (aperture: 0.08, haze: 0.6, shadow: 0.5),
    sky: "sky",
    fog: (214, 196, 170),
    far: 45.0,
    kinds: {
        // A worker termite modelled from a photograph (Higgsfield: image → textured PBR mesh), rigged and animated in
        // Blender (tools/blender/rig_insect.py). Its clips follow the game's machine: carrying mud → `carry`,
        // otherwise `walk`; standing still → `idle`.
        "termite": (carries_in: "Carrying", model: (
            file: "models/termite.glb",
            lods: [(4.0, "models/termite_lod1.glb"), (10.0, "models/termite_lod2.glb")],   // measured: --stress, 960 termites
            length: 0.8,
            clips: [("Carrying", "carry"), ("*", "walk")],
            still: "idle",
            rate: 1.6,
            carry: "carry",
        )),
    },
    smell: (field: "cement", color: (190, 255, 120), full: 50000, radius: 8),
    feel: (
        eye: 0.35, radius: 0.3, height: 0.45,
        walk: 2.5, run: 5.0, accel: 9.0, air: 2.5, climb: 2.0,
        jump: 4.5, gravity: 14.0,
        sensitivity: 0.12, look_smooth: 16.0,
        bob: 0.025, bob_rate: 1.6, fov: 72.0, run_fov: 82.0, lean: 2.5, land_dip: 0.012,
        eye_glide: 18.0,   // feel step 001: the eye glides after the body (0 = bolted)
    ),
)
