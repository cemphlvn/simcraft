<!-- Tests the Unity-free layer (Native.cs, Simulation.cs) with plain .NET.
     Run from the repo root: adapters/build-native.sh, then: dotnet run (project adapters/unity/tests) -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../com.simcraft.core/Runtime/Native.cs" />
    <Compile Include="../com.simcraft.core/Runtime/Simulation.cs" />
    <None Include="../../../target/release/libsimcraft.dylib" Condition="Exists('../../../target/release/libsimcraft.dylib')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../target/release/libsimcraft.so" Condition="Exists('../../../target/release/libsimcraft.so')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../target/release/simcraft.dll" Condition="Exists('../../../target/release/simcraft.dll')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
