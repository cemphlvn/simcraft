#![enable(implicit_some)]
// Seasons: summer, autumn, winter, and how ripe the land is.
// Any game can use it: `environments: ["seasons"]`, then read `env.seasons.state` and `env.seasons.ripeness`.
Environment(
    name: "seasons",

    params: {
        // Calendar (ticks). A year is summer + autumn + winter.
        "summer": 240, "autumn": 120, "winter": 120,
        "warmth_lag": 60,    // warmth peaks this long after mid-summer... and is lowest mid-winter
        "ripe_floor": 0,     // ripeness never below this while the land grows (early flowers); 0 = off
    },

    // Ripeness 0..100: rises from the start of summer to a peak, falls to 0 by the end of autumn, 0 in winter.
    // Warmth 0..100: temperature through the year, lowest mid-winter, highest late summer.
    props: { "ripeness": 0, "warmth": 0 },

    fsm: "season",
    fsms: {
        "season": (
            initial: "Summer",
            transitions: [
                (from: "Summer", to: "Autumn", when: "tick % (p.summer + p.autumn + p.winter) >= p.summer"),
                (from: "Autumn", to: "Winter", when: "tick % (p.summer + p.autumn + p.winter) >= p.summer + p.autumn"),
                (from: "Winter", to: "Summer", when: "tick % (p.summer + p.autumn + p.winter) < p.summer"),
            ],
        ),
    },

    rules: [
        (name: "ripening",
         then: [ Set("ripeness", "max(if tick % (p.summer + p.autumn + p.winter) < p.summer + p.autumn { p.ripe_floor } else { 0 }, triangle(tick % (p.summer + p.autumn + p.winter), p.summer + p.autumn, 100))") ]),
        (name: "weather",
         then: [ Set("warmth", "triangle((tick + p.warmth_lag) % (p.summer + p.autumn + p.winter), p.summer + p.autumn + p.winter, 100)") ]),
    ],
)
